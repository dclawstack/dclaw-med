# DClaw Med Environment Variables
# Copy this file to .env and fill in the values

# Database
DB_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dclaw_med

# AI Providers (OpenAI-compatible)
# Default: OpenRouter cloud. Set LLM_BASE_URL + LLM_MODEL to swap to any
# OpenAI-compatible server (e.g. a local Ollama at
# http://host.docker.internal:11434/v1 with LLM_MODEL=llama3.2:3b).
# OPENROUTER_API_KEY just needs to be non-empty for non-OpenRouter
# providers — set it to anything (e.g. "ollama") to clear the
# mocked-LLM guard.
OPENROUTER_API_KEY=          # Required for cloud models; any non-empty string for local providers
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=moonshotai/kimi-k2
# Per-call timeout. 30s is fine for cloud; bump to 120-180s for
# a local 3B model emitting structured JSON.
LLM_TIMEOUT_SECONDS=30

# Auth (Logto) — leave empty if not using SSO
LOGTO_ENDPOINT=
LOGTO_AUDIENCE=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8092
CORS_ORIGINS=http://localhost:3004,http://localhost:3000

# Auth (JWT)
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
